CLIENT_ID=
CLIENT_SECRET=
USER_ID=
REFRESH_TOKEN=
COUNTRY_CODE=

# Optional unrestricted credential for search, albums, artists, playlists, etc.
# Prefer a refreshable credential (an account without an active subscription is fine).
CATALOG_CLIENT_ID=
CATALOG_CLIENT_SECRET=
CATALOG_REFRESH_TOKEN=
CATALOG_USER_ID=
# Alternatively provide a static bearer token (it cannot be refreshed automatically).
# CATALOG_TOKEN=

USE_PROXIES=False
ROTATE_PROXIES_ON_REFRESH=False
PROXIES_FILE=proxies.txt
MAX_RETRIES=2
# WARNING: If set to True, the app will expose the host IP if all proxies fail or proxies.txt is misconfigured!
FALLBACK_TO_DIRECT_CONNECTION=False
# Override the User-Agent sent to Tidal
# USER_AGENT=okhttp/5.3.2
# Enable verbose logging of every upstream request (status, headers, body)
# DEV_MODE=True

# --- Downloads -------------------------------------------------------------
# WARNING: Downloading full audio is far more detectable by Tidal than ordinary
# streaming and is a common cause of account suspension. Opt in deliberately.
ENABLE_DOWNLOADS=False
# Where downloaded audio is written (relative paths resolve against the CWD).
DOWNLOAD_DIR=downloads
# Path template. Available fields: {artist} {album} {title} {number} {quality}
# {year} {isrc}. Each component is sanitised before use.
DOWNLOAD_TEMPLATE={artist}/{album}/{number:02d}. {title}
# Default quality for downloads: LOW | HIGH | LOSSLESS | HI_RES_LOSSLESS
DOWNLOAD_QUALITY=HI_RES_LOSSLESS
# Skip re-downloading a file that already exists on disk.
DOWNLOAD_SKIP_EXISTING=True
# Per-track ceiling in bytes (default 2 GiB).
DOWNLOAD_MAX_BYTES=2147483648
